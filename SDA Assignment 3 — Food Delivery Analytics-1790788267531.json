                      "spec": {
                        "dataset": "sda_course",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\r\n    100.0 * SUM(\r\n        CASE\r\n            WHEN actual_delivery_time <= estimated_delivery_time\r\n            THEN 1\r\n            ELSE 0\r\n        END\r\n    ) / COUNT(*) AS on_time_percentage\r\nFROM food_delivery_events\r\nWHERE actual_delivery_time IS NOT NULL\r\n  AND estimated_delivery_time IS NOT NULL\r\n  AND actual_delivery_time > 0\r\n  AND estimated_delivery_time > 0;",
